#include<stdio.h>
#include<math.h>
int main()
{
    int num,counter=0;
    printf("Enter any number to find the number of digits :");
    scanf("%d",&num);
    while (num!=0)
    {
        num=num/10;
        counter++;
    }
    printf("There are %d digits in the above number",counter);
    
    return 0;
}
